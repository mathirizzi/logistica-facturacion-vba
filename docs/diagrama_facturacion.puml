@startuml

title Proceso completo de facturación - Logistica RMA

skinparam shadowing false

start

partition "1. Configuración" {

    :Iniciar proceso de facturación;

    :Cargar configuración;

    note right
        Parámetros:
        FechaDesde
        FechaHasta
        Cliente
        ModoDebug
    end note

    :Validar parámetros;

    if (Parámetros válidos?) then (Sí)
        :Continuar;
    else (No)
        :Registrar error;
        :Informar al usuario;
        stop
    endif
}


partition "2. Inicialización" {

    :Inicializar estructuras internas;

    note right
        Diccionarios
        Arrays
        Variables de control
        Mapeo dinámico de columnas
    end note

    :Leer encabezados de las hojas;

    :Validar encabezados;

    if (Encabezados válidos?) then (Sí)
        :Continuar;
    else (No)
        :Registrar error;
        :Informar al usuario;
        stop
    endif

    :Validar estructura requerida;

    if (Estructura válida?) then (Sí)
        :Continuar;
    else (No)
        :Registrar error;
        :Informar al usuario;
        stop
    endif
}


partition "3. Lectura de datos" {

    :Leer stock inicial;

    :Cargar stock inicial
    en estructura interna;

    :Leer movimientos;

    :Cargar movimientos
    en estructura interna;

    :Filtrar movimientos
    fuera del período;

    :Identificar movimientos
    no facturables;
}


partition "4. Validación de datos" {

    :Validar integridad
    de los datos;

    if (Datos inválidos?) then (Sí)

        :Registrar inconsistencias;

        if (ModoDebug?) then (Sí)
            :Mostrar detalle técnico;
        else (No)
            :Continuar;
        endif

        :Informar inconsistencias;

        if (Continuar procesamiento?) then (Sí)
            :Continuar;
        else (No)
            stop
        endif

    else (No)

        :Continuar;

    endif
}


partition "5. Procesamiento de movimientos" {

    :Ordenar movimientos
    cronológicamente;

    :Recorrer movimientos;

    :Obtener movimiento;

    :Identificar pallet;

    :Identificar tipo de movimiento;

    if (Movimiento facturable?) then (Sí)

        if (Movimiento IN?) then (Sí)

            :Registrar entrada del pallet;

            :Generar cargo IN;

        else (No)

            if (Movimiento OUT?) then (Sí)

                :Registrar salida del pallet;

                :Generar cargo OUT;

            else (No)

                if (Movimiento PK?) then (Sí)

                    :Registrar salida parcial;

                    :Generar cargo PK;

                else (No)

                    :Registrar movimiento
                    no reconocido;

                endif

            endif

        endif

    else (No)

        :Ignorar movimiento
        para facturación;

    endif
}


partition "6. Cálculo de stock" {

    :Tomar stock inicial;

    :Aplicar movimientos válidos;

    :Calcular stock teórico;

    :Determinar stock final;

    if (Stock consistente?) then (Sí)

        :Continuar;

    else (No)

        :Registrar diferencia;

        :Informar inconsistencia;

        if (Continuar?) then (Sí)

            :Continuar;

        else (No)

            stop

        endif

    endif
}


partition "7. Cálculo de estadía" {

    :Determinar rango
    de fechas;

    :Determinar pallets
    presentes;

    :Calcular estadía
    por día;

    :Acumular estadía
    del período;
}


partition "8. Consolidación de facturación" {

    :Consolidar cargos IN;

    :Consolidar cargos OUT;

    :Consolidar cargos PK;

    :Consolidar cargos de estadía;

    :Aplicar tarifas;

    note right
        IN:
        cantidad × tarifa IN

        OUT:
        cantidad × tarifa OUT

        PK:
        cantidad × tarifa PK

        ESTADÍA:
        pallet/día × tarifa
    end note

    :Generar detalle
    de facturación;
}


partition "9. Control final" {

    :Validar detalle
    de facturación;

    :Controlar pallets;

    :Controlar movimientos;

    :Controlar cantidades;

    :Controlar fechas;

    :Controlar cargos;

    if (Hay inconsistencias?) then (Sí)

        :Registrar errores;

        :Marcar facturación
        para revisión;

        :Mostrar inconsistencias;

    else (No)

        :Marcar facturación
        como válida;

    endif
}


partition "10. Generación de salida" {

    :Generar reporte
    de facturación;

    :Generar detalle
    por concepto;

    :Generar resumen;

    note right
        Resumen:
        Estadía
        IN
        OUT
        PK
        Total
    end note

    :Guardar resultado;
}


stop

@enduml

